# Server
PORT=3000
NODE_ENV=production
WEB_CONCURRENCY=1

# JWT
# Production: минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_TTL_SEC=2592000

# LDAP
LDAP_URL=ldap://your-ldap:389
LDAP_BIND_DN=CN=svc,OU=Service,DC=example,DC=ru
LDAP_BIND_CREDENTIALS=change-me
LDAP_SEARCH_BASE=DC=example,DC=ru
LDAP_SEARCH_FILTER=(|(sAMAccountName={{username}})(userPrincipalName={{username}}))
LDAP_SEARCH_ATTRIBUTES=displayName,mail,sAMAccountName
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=3000

# Redis: обязателен в production (refresh-токены и общий rate-limit)
REDIS_URL=redis://redis:6379
# Сколько ждать Redis при старте (мс), прежде чем работать без него
REDIS_CONNECT_TIMEOUT_MS=2000
# Сколько хранить последний успешный ответ для stale-if-error (секунды)
CACHE_STALE_TTL_SEC=86400

# Внешний API расписания
SCHEDULE_API_URL=https://external-schedule-api.example.com
SCHEDULE_API_TIMEOUT_MS=10000
SCHEDULE_API_BEARER_TOKEN=change-me-external-api-token

# CORS: список origin через запятую для web-клиента.
# Пусто = CORS выключен (мобильному приложению CORS не нужен).
# CORS_ORIGINS=https://schedule.example.ru
