# Скопируйте в /etc/schedulemasu/deploy.env и выполните chmod 600.
# Этот файл содержит токен GHCR и не должен попадать в git.

# Каталог api на сервере (внутри checkout репозитория)
DEPLOY_PATH=/opt/schedulemasu/api

# Полные имена образов без тега; тег задаётся отдельно.
API_IMAGE=ghcr.io/horizon-spark/schedulemasu-api
NGINX_IMAGE=ghcr.io/horizon-spark/schedulemasu-nginx

# production обновляется только по тегам v*; staging — по main.
IMAGE_TAG=production

# Нужны, если пакеты GHCR приватные.
# GHCR_USER=github-user
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Обновлять compose-файлы из репозитория перед деплоем.
# Поставьте 0, если сервер не должен ходить в GitHub.
PULL_GIT=1
GIT_BRANCH=main

COMPOSE_FILES="-f docker-compose.yml -f docker-compose.tls.yml"
# Если TLS ещё не настроен, используйте только базовый compose:
# COMPOSE_FILES="-f docker-compose.yml"
HEALTH_TIMEOUT_SEC=90
STATE_FILE=/var/lib/schedulemasu/deploy.state
LOCK_FILE=/var/lock/schedulemasu-deploy.lock
